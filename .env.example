# Optional: extra directory searched for ready-made PDFs (--pdf-variant).
# Variant naming follows copys: a4 -> <stem>.pdf, a5 -> <stem>.a5.pdf, a4-blt -> <stem>.booklet.pdf
PDF_SOURCE=${USERPROFILE}/Share/projs-site/marks/copy/_output/pdfs

# Optional: central run-directory root. Default: <md_dir>/_output/runs
# (copys-style tree; runs land next to the book's pdfs/ and latex/).
# READALONG_RUNS=${USERPROFILE}/some/central/runs
